{
  "name": "rule-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
