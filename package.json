    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ruby/3.4-wasm-wasi": "2.10.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "@playwright/test": "1.63.0"
  }
}
